{
    "BasedOnStyle": "Chromium",
    "IndentWidth": "4",
    "ColumnLimit": "80",
    "AllowShortIfStatementsOnASingleLine": "true",
    "AllowShortBlocksOnASingleLine": "Always",
    "AllowShortLoopsOnASingleLine": "true",

    "IncludeBlocks": "Regroup",
    "IncludeCategories": [
        {
            "Regex": "^\"",
            "Priority": 1
        },
        {
            "Regex": "^<(cuda|cufft|curand|cusparse|cusolver|cublas|nvToolsExt|nvrtc|cooperative_groups|cuComplex)",
            "Priority": 2
        },
        {
            "Regex": "^<[a-z_]+>",
            "Priority": 3
        },
        {
            "Regex": "^<",
            "Priority": 4
        }
    ]
}
