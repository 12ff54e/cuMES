struct Params {
    ns: u32,
    n_z_n_t: u32,
    ntheta: u32,
    nzeta: u32,
    full_points: u32,
    half_points: u32,
    prescribed_current: u32,
    _padding0: u32,
    lamscale: f32,
    lamscale_lo: f32,
    _padding2: u32,
    _padding3: u32,
};

struct Values { data: array<f32>, };
@group(0) @binding(0) var<storage, read> geometry_hi: Values;
@group(0) @binding(1) var<storage, read> base_hi: Values;
@group(0) @binding(2) var<storage, read> profiles_hi: Values;
// High fields/chip/iota followed by the corresponding low values.
@group(0) @binding(3) var<storage, read_write> field: Values;
@group(0) @binding(4) var<uniform> params: Params;
#if PAIRED
@group(0) @binding(5) var<storage, read> geometry_lo: Values;
@group(0) @binding(6) var<storage, read> base_lo: Values;
@group(0) @binding(7) var<storage, read> profiles_lo: Values;
#endif
fn result_values() -> u32 {
    return 5u * params.half_points + 2u * (params.ns - 1u);
}
fn full(field_index: u32, point: u32, slot: u32) -> Real {
    let index = field_index * params.full_points + point;
    return normalize(words(geometry_hi.data[index], geometry_lo.data[index]), slot);
}
fn half(field_index: u32, point: u32, slot: u32) -> Real {
    let index = field_index * params.half_points + point;
    return normalize(words(base_hi.data[index], base_lo.data[index]), slot);
}
fn profile(index: u32, slot: u32) -> Real {
    return normalize(words(profiles_hi.data[index], profiles_lo.data[index]), slot);
}
fn field_at(field_index: u32, point: u32, slot: u32) -> Real {
    let index = field_index * params.half_points + point;
    return normalize(words(field.data[index], field.data[result_values() + index]),
                   slot);
}
fn store_index(index: u32, value: Real) {
    field.data[index] = hi(value);
#if PAIRED
    field.data[result_values() + index] = lo(value);
#endif
}
fn store(field_index: u32, point: u32, value: Real) {
    store_index(field_index * params.half_points + point, value);
}

@compute @workgroup_size(256)
fn main(@builtin(global_invocation_id) invocation: vec3<u32>) {
    let point = invocation.x;
    if (point >= params.half_points) { return; }
    let surface = point / params.n_z_n_t;
    let angular = point % params.n_z_n_t;
    let inside = surface * params.n_z_n_t + angular;
    let outside = inside + params.n_z_n_t;
    let half_count = params.ns - 1u;
    let sqrt_h = profile(surface, point);
    let lu_h = scale(add(
        add(full(5u, inside, point), full(5u, outside, point), point),
        mul(sqrt_h, add(full(11u, inside, point),
                              full(11u, outside, point), point), point), point),
        0.5, point);
    let lv_h = scale(add(
        add(full(14u, inside, point), full(14u, outside, point), point),
        mul(sqrt_h, add(full(17u, inside, point),
                              full(17u, outside, point), point), point), point),
        0.5, point);
    let phip_offset = half_count;
    let chip_offset = phip_offset + params.ns;
    let pres_offset = chip_offset + half_count;
    let phip_average = scale(add(
        profile(phip_offset + surface, point),
        profile(phip_offset + surface + 1u, point), point), 0.5, point);
    let gsqrt = half(6u, point, point);
    var bsupu = real(0.0);
    var bsupv = real(0.0);
    if (abs(hi(gsqrt)) > 1.0e-30 && abs(hi(gsqrt)) <= 3.402823e38) {
        let lamscale = words(params.lamscale, params.lamscale_lo);
        bsupv = div(add(mul(lamscale, lu_h, point), phip_average, point),
                       gsqrt, point);
        bsupu = div(mul(lamscale, lv_h, point), gsqrt, point);
        if (params.prescribed_current == 0u) {
            bsupu = add(bsupu,
                div(profile(chip_offset + surface, point), gsqrt, point), point);
        }
    }
    store(0u, point, bsupu); store(1u, point, bsupv);
    if (params.prescribed_current != 0u) {
        // Evaluate the current integrands in parallel. Fields 2/3
        // are scratch until finalize_fields overwrites them. Keep the exact
        // original normalization and arithmetic, including field_at's
        // renormalization of the stored contravariant fields.
        let reduced_ntheta = params.ntheta / 2u + 1u;
        let itheta = angular % params.ntheta;
        if (itheta < reduced_ntheta) {
            var weight = reciprocal(
                words(f32(params.nzeta * (reduced_ntheta - 1u)), 0.0), point);
            if (itheta == 0u || itheta == reduced_ntheta - 1u) {
                weight = scale(weight, 0.5, point);
            }
            let integrand = add(
                mul(half(7u, point, point), field_at(0u, point, point), point),
                mul(half(8u, point, point), field_at(1u, point, point), point), point);
            store(2u, point, mul(integrand, weight, point));
            var average_term = real(0.0);
            if (abs(hi(gsqrt)) > 1.0e-30 && abs(hi(gsqrt)) <= 3.402823e38) {
                average_term = mul(
                    div(half(7u, point, point), gsqrt, point), weight, point);
            }
            store(3u, point, average_term);
        }
        return;
    }
    let bsubu = add(mul(half(7u, point, point), bsupu, point),
                       mul(half(8u, point, point), bsupv, point), point);
    let bsubv = add(mul(half(8u, point, point), bsupu, point),
                       mul(half(9u, point, point), bsupv, point), point);
    let pressure = add(scale(add(mul(bsupu, bsubu, point),
        mul(bsupv, bsubv, point), point), 0.5, point),
        profile(pres_offset + surface, point), point);
    store(2u, point, bsubu); store(3u, point, bsubv);
    store(4u, point, pressure);
}

// One workgroup per surface distributes the ordered reductions across SMs;
// 64 surfaces in one group would leave almost the entire W7-X GPU idle.
@compute @workgroup_size(1)
fn finalize_current(@builtin(global_invocation_id) invocation: vec3<u32>) {
    let surface = invocation.x;
    let half_count = params.ns - 1u;
    if (surface >= half_count) { return; }
    let field_values = 5u * params.half_points;
    let chip_result = field_values + surface;
    let iota_result = field_values + half_count + surface;
    let phip_offset = half_count;
    let chip_offset = phip_offset + params.ns;
    let pres_offset = chip_offset + half_count;
    let curr_offset = pres_offset + half_count;
    let phip_h_offset = curr_offset + half_count;
    let iota_offset = phip_h_offset + half_count;
    if (params.prescribed_current == 0u) {
        store_index(chip_result, profile(chip_offset + surface, surface));
        store_index(iota_result, profile(iota_offset + surface, surface));
        return;
    }
    let reduced_ntheta = params.ntheta / 2u + 1u;
    let base_point = surface * params.n_z_n_t;
    var jv = real(0.0);
    var average = real(0.0);
    for (var izeta = 0u; izeta < params.nzeta; izeta++) {
        for (var itheta = 0u; itheta < reduced_ntheta; itheta++) {
            let point = base_point + izeta * params.ntheta + itheta;
            let gsqrt = half(6u, point, surface);
            // Read the exact precomputed words, without an extra normalize.
            let jv_index = 2u * params.half_points + point;
            let average_index = 3u * params.half_points + point;
            jv = add(jv, words(field.data[jv_index],
                field.data[result_values() + jv_index]), surface);
            if (abs(hi(gsqrt)) > 1.0e-30 && abs(hi(gsqrt)) <= 3.402823e38) {
                average = add(average, words(field.data[average_index],
                    field.data[result_values() + average_index]), surface);
            }
        }
    }
    var chip = real(0.0);
    if (hi(average) != 0.0) {
        chip = div(sub(profile(curr_offset + surface, surface), jv, surface),
                      average, surface);
    }
    var iota = profile(iota_offset + surface, surface);
    let phip_h = profile(phip_h_offset + surface, surface);
    if (hi(phip_h) != 0.0) { iota = div(chip, phip_h, surface); }
    store_index(chip_result, chip); store_index(iota_result, iota);
}

// The current integral is one serial reduction per surface. Once chip is
// known, finalize every angular point independently instead of serializing all
// 1080 W7-X points inside that surface invocation.
@compute @workgroup_size(256)
fn finalize_fields(@builtin(global_invocation_id) invocation: vec3<u32>) {
    let point = invocation.x;
    if (point >= params.half_points || params.prescribed_current == 0u) {
        return;
    }
    let surface = point / params.n_z_n_t;
    let half_count = params.ns - 1u;
    let field_values = 5u * params.half_points;
    let chip_result = field_values + surface;
    let pres_offset = half_count + params.ns + half_count;
    let chip = words(field.data[chip_result],
                  field.data[result_values() + chip_result]);
    let gsqrt = half(6u, point, point);
    var bsupu = field_at(0u, point, point);
    let bsupv = field_at(1u, point, point);
    if (abs(hi(gsqrt)) > 1.0e-30 && abs(hi(gsqrt)) <= 3.402823e38) {
        bsupu = add(bsupu, div(chip, gsqrt, point), point);
    }
    let bsubu = add(mul(half(7u, point, point), bsupu, point),
                       mul(half(8u, point, point), bsupv, point), point);
    let bsubv = add(mul(half(8u, point, point), bsupu, point),
                       mul(half(9u, point, point), bsupv, point), point);
    let pressure = add(scale(add(
        mul(bsupu, bsubu, point), mul(bsupv, bsubv, point), point),
        0.5, point), profile(pres_offset + surface, point), point);
    store(0u, point, bsupu);
    store(2u, point, bsubu);
    store(3u, point, bsubv);
    store(4u, point, pressure);
}
