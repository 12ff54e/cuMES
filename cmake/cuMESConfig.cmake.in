@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(CUDAToolkit 11)
find_dependency(Threads)

set(_cumes_netcdf_target "@CUMES_PACKAGE_NETCDF_TARGET@")
if(_cumes_netcdf_target MATCHES "^PkgConfig::")
  find_dependency(PkgConfig)
  pkg_check_modules(netCDF REQUIRED IMPORTED_TARGET netcdf)
elseif(_cumes_netcdf_target MATCHES "^netCDF::")
  find_dependency(netCDF)
endif()

if(@CUMES_HAVE_HDF5@)
  find_dependency(HDF5 COMPONENTS C)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cuMESTargets.cmake")
check_required_components(cuMES)
