{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "verify",
      "displayName": "Verify \u2014 verify-double, release, all backends (default)",
      "description": "The verification configuration: precise double math (CUMES_PRECISION_POLICY=verify-double), NetCDF+HDF5 on when found.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUMES_PRECISION_POLICY": "verify-double",
        "CUMES_USE_FLOAT": "OFF",
        "CUMES_USE_NETCDF": "ON",
        "CUMES_USE_HDF5": "ON",
        "CUMES_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "float",
      "displayName": "Float \u2014 mixed-float (experimental)",
      "description": "Mixed-float policy: float state/FFT with the documented double reductions (CUMES_PRECISION_POLICY=mixed-float implies CUMES_USE_FLOAT). Float stalls at ~1e-7; relax ftol_array entries to >= 1e-6.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-float",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUMES_PRECISION_POLICY": "mixed-float",
        "CUMES_USE_FLOAT": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug \u2014 debug-double, symbols, device checks",
      "description": "Debug-double policy: precise math plus device debug checks (-G -lineinfo).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CUMES_PRECISION_POLICY": "debug-double",
        "CUMES_USE_FLOAT": "OFF"
      }
    },
    {
      "name": "fast",
      "displayName": "Fast \u2014 fast-double (attributable fast intrinsics)",
      "description": "Fast-double policy: --use_fast_math, selected and attributed through the named policy (never the default).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-fast",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUMES_PRECISION_POLICY": "fast-double",
        "CUMES_USE_FLOAT": "OFF",
        "CUMES_ENABLE_VERIFY_DUMP": "OFF"
      }
    },
    {
      "name": "sanitizer",
      "displayName": "Sanitizer \u2014 double + full sanitizer matrix",
      "description": "Registers compute-sanitizer memcheck/racecheck/synccheck variants of the kernel-driving tests and builds the host-only targets with ASan+UBSan.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CUMES_PRECISION_POLICY": "verify-double",
        "CUMES_USE_FLOAT": "OFF",
        "CUMES_ENABLE_SANITIZER_TESTS": "ON",
        "CUMES_ENABLE_EXTRA_SANITIZER_TOOLS": "ON",
        "CUMES_HOST_SANITIZERS": "ON",
        "CUMES_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "nobackend",
      "displayName": "No-backend \u2014 binary-only output (CI matrix entry)",
      "description": "Builds without NetCDF/HDF5 so the binary-only fallback path is exercised.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-nobackend",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUMES_USE_FLOAT": "OFF",
        "CUMES_USE_NETCDF": "OFF",
        "CUMES_USE_HDF5": "OFF"
      }
    },
    {
      "name": "fixed-only",
      "displayName": "Fixed-only — no optional vacuum-field dependency",
      "description": "Builds fixed-boundary cuMES without configuring or linking deps/vacuum-field.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-fixed-only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUMES_USE_FLOAT": "OFF",
        "CUMES_USE_VACUUM_FIELD": "OFF"
      }
    },
    {
      "name": "netcdf-only",
      "displayName": "NetCDF-only \u2014 binary + NetCDF output (CI matrix entry)",
      "description": "Builds with NetCDF but without HDF5 so the single-backend adapter path is exercised (completion-plan follow-up §3.3).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-netcdf-only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUMES_USE_FLOAT": "OFF",
        "CUMES_USE_NETCDF": "ON",
        "CUMES_USE_HDF5": "OFF"
      }
    },
    {
      "name": "hdf5-only",
      "displayName": "HDF5-only \u2014 binary + HDF5 output (CI matrix entry)",
      "description": "Builds with HDF5 but without NetCDF so the single-backend adapter path is exercised (completion-plan follow-up §3.3).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-hdf5-only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUMES_USE_FLOAT": "OFF",
        "CUMES_USE_NETCDF": "OFF",
        "CUMES_USE_HDF5": "ON"
      }
    },
    {
      "name": "profiling",
      "displayName": "Profiling \u2014 double + lineinfo + ptxas verbosity",
      "description": "Adds -lineinfo and ptxas -v to the CUDA flags for Nsight/ptxas analysis.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-prof",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUMES_USE_FLOAT": "OFF",
        "CMAKE_CUDA_FLAGS": "-lineinfo -Xptxas=-v"
      }
    },
    {
      "name": "webgpu",
      "displayName": "WebGPU — Emscripten + emdawnwebgpu (mixed-float)",
      "description": "Browser/Wasm build. Invoke through emcmake so CMake uses the Emscripten toolchain.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../tmp/cumes-build-webgpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUMES_BACKEND": "WEBGPU",
        "CUMES_PRECISION_POLICY": "mixed-float",
        "CUMES_USE_FLOAT": "ON",
        "CUMES_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "verify",
      "configurePreset": "verify"
    },
    {
      "name": "float",
      "configurePreset": "float"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "fast",
      "configurePreset": "fast"
    },
    {
      "name": "sanitizer",
      "configurePreset": "sanitizer"
    },
    {
      "name": "nobackend",
      "configurePreset": "nobackend"
    },
    {
      "name": "fixed-only",
      "configurePreset": "fixed-only"
    },
    {
      "name": "netcdf-only",
      "configurePreset": "netcdf-only"
    },
    {
      "name": "hdf5-only",
      "configurePreset": "hdf5-only"
    },
    {
      "name": "profiling",
      "configurePreset": "profiling"
    },
    {
      "name": "webgpu",
      "configurePreset": "webgpu"
    }
  ],
  "testPresets": [
    {
      "name": "verify",
      "configurePreset": "verify",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitizer",
      "configurePreset": "sanitizer",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "webgpu",
      "configurePreset": "webgpu",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
